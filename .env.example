# Copy to .env.local and fill in per-environment values. NEVER commit real values.
# Names are the contract (see docs/devops-strategy.md §7) — keep them identical
# across local, Vercel scopes, and CI.

# --- Supabase (per environment: testing vs prod) ---
# Safe to expose to the client:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row-level security. Never prefix with NEXT_PUBLIC_,
# never import into client code. Lives only in Vercel/GitHub secret stores.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CI only — used by the migration job (supabase db push). Not read at runtime.
SUPABASE_DB_PASSWORD=your-db-password

# SERVER ONLY. Who may sign in (UIL-127c). SIGNUP_MODE=open lets any address sign up (the first link
# creates the account), but only with NEXT_PUBLIC_TURNSTILE_SITE_KEY set too; anything else, or unset, or
# open with no site key, is INVITE mode: only ALLOWED_EMAILS (comma-separated)
# and ALLOWED_OWNER_EMAIL (the original single owner, dev-spec §3 decision 4). Set SIGNUP_MODE in Vercel
# AND the GitHub environment in the same step: the deploy smoke's stranger probe reads the GitHub one.
SIGNUP_MODE=invite
ALLOWED_EMAILS=
ALLOWED_OWNER_EMAIL=owner@example.com

# Safe to expose. Cloudflare Turnstile's public site key, for the sign-in bot check (UIL-127c). Wherever it is
# set the check shows, in either mode. The safe order (docs/go-live-runbook.md): set it with SIGNUP_MODE still
# invite, deploy, confirm the check shows and she can sign in; THEN turn on CAPTCHA in that Supabase project's
# Auth settings with the Turnstile secret and confirm she still can; only THEN set SIGNUP_MODE=open. With
# CAPTCHA on and no token Supabase refuses every sign-in; with open mode and CAPTCHA off, any token passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- TCGdex catalog ---
# Public community catalog, no key required. Override only if proxying.
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
