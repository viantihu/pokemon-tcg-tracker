# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Deploy's `acceptance` job writes this vitest JSON report into the workspace root to
# prove the suite really ran; a local run of the same command leaves one behind too.
acceptance-report.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore all real env files, but keep the documented template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dex CSV exports contain the full personal collection — never commit them.
# Exception: tiny anonymized fixture slices under tests/.
*.csv
!tests/**/*.csv

# Supabase CLI local artifacts
supabase/.temp/
supabase/.branches/

# Claude Code local scratch — per-machine settings and agent worktrees (full checkouts with
# their own build output). Shared .claude config (if any) can be force-added past these.
.claude/settings.local.json
.claude/worktrees/
